# ============================================================================
# Secrets Management Configuration
# ============================================================================
# Set to "true" to use AWS Secrets Manager (for EC2 deployment)
# Set to "false" or leave unset to use .env file (for local development)
USE_AWS_SECRETS=false

# AWS Secrets Manager settings (only used if USE_AWS_SECRETS=true)
AWS_REGION=us-east-1
AWS_SECRETS_NAME=forge/api-keys

# Azure OpenAI API settings
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2023-05-15

# GitHub API settings
GITHUB_TOKEN=

# ============================================================================
# LLM Behavior Settings
# ============================================================================

# LLM settings
LLM_PROVIDER=azure
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.1
# reasoning_effort replaces temperature for GPT-5 reasoning models
# Valid values: none, minimal, low, medium, high
LLM_REASONING_EFFORT=medium
LLM_MAX_TOKENS=8000

# Storage settings
BLUEPRINT_STORAGE_DIR=./data/blueprints
PROMPTS_DIR=./config/prompts

# Logging settings
LOG_LEVEL=INFO

# Reliability configuration
export CIRCUIT_BREAKER_FAILURE_THRESHOLD="5"
export CIRCUIT_BREAKER_RECOVERY_TIMEOUT="60"
export MAX_CONCURRENT_CONTAINERS="5"
export CONTAINER_BUILD_TIMEOUT="300"

# Framework and dependency configuration
export ENABLE_GUIDED_PROCESS="true"
export FORCE_FRAMEWORK_TYPE=""
export DEFAULT_ADDITIONAL_DEPENDENCIES=""

# LLM Enhancement Features (Optional)
export ENABLE_LLM_EXPLOITATION_GUIDANCE="true"
export ENABLE_LLM_SIMILARITY_ANALYSIS="true"
export ENABLE_LLM_FRAMEWORK_DETECTION="false"
export LLM_EXPLOITATION_TIMEOUT="30"
export LLM_SIMILARITY_TIMEOUT="45"
export LLM_FRAMEWORK_TIMEOUT="20"

# IoC Collection Configuration
export IOC_COLLECTION_ENABLED="true"
export IOC_STRUCTURED_STORAGE_ENABLED="true"
export IOC_MIN_CONFIDENCE_THRESHOLD="0.1"
export IOC_MAX_IOCS_PER_TYPE="100"
export IOC_COLLECTION_TIMEOUT="30"
export IOC_ENABLE_DETAILED_EXTRACTION="true"

# IoC Pattern Types
export IOC_NETWORK_PATTERNS_ENABLED="true"
export IOC_FILESYSTEM_PATTERNS_ENABLED="true"
export IOC_PROCESS_PATTERNS_ENABLED="true"
export IOC_APPLICATION_PATTERNS_ENABLED="true"
export IOC_TIMING_PATTERNS_ENABLED="true"
export IOC_BEHAVIORAL_PATTERNS_ENABLED="true"
